---
import type { AppInfo, Locale } from '../data/apps';

type Props = {
  app: AppInfo;
  locale: Locale;
  compact?: boolean;
};

const { app, locale, compact = false } = Astro.props;
const appHref = locale === 'zh' ? `/zh/apps/${app.slug}/` : `/apps/${app.slug}/`;
const helpHref = app.help && locale === 'zh' ? app.help.replace('/help/', '/zh/help/') : app.help;
const appleStoreLabel = app.platforms.includes('macOS') ? 'Mac App Store' : 'App Store';
const additionalStores = [
  app.microsoftStore && { href: app.microsoftStore, label: 'Microsoft Store', icon: '⊞' },
  app.appGallery && { href: app.appGallery, label: 'Huawei AppGallery', icon: 'H' },
].filter(Boolean) as { href: string; label: string; icon: string }[];
const showStoreMenu = additionalStores.length > 1;
---

<article class:list={['app-card', compact && 'app-card--compact']}>
  <a class="app-card__main" href={appHref} aria-label={`${app.name} details`}>
    {app.icon ? <img class="app-card__icon" src={app.icon} alt={`${app.name} icon`} /> : <div class="app-card__fallback">{app.fallbackIcon ?? app.name.slice(0, 1)}</div>}
    <div>
      <h3>{app.name}</h3>
      <p>{app.tagline[locale]}</p>
    </div>
  </a>
  <div class="platforms" aria-label="Platforms">
    {app.platforms.map((item) => <span>{item}</span>)}
  </div>
  {!compact && <p class="app-card__summary">{app.summary[locale]}</p>}
  <div class="app-card__actions">
    <a class="button button--secondary" href={appHref}>{locale === 'zh' ? '查看介绍' : 'Learn more'}</a>
    {app.appStore && (
      <a
        class="button button--ghost button--icon"
        href={app.appStore}
        target="_blank"
        rel="noopener"
        aria-label={appleStoreLabel}
        title={appleStoreLabel}
      >
        
      </a>
    )}
    {additionalStores.length === 1 && (
      <a
        class="button button--ghost button--icon"
        href={additionalStores[0].href}
        target="_blank"
        rel="noopener"
        aria-label={additionalStores[0].label}
        title={additionalStores[0].label}
      >
        {additionalStores[0].icon}
      </a>
    )}
    {showStoreMenu && (
      <details class="store-menu">
        <summary class="button button--ghost button--icon" title={locale === 'zh' ? '更多下载平台' : 'More download platforms'}>
          <span aria-hidden="true">•••</span>
          <span class="visually-hidden">{locale === 'zh' ? '更多下载平台' : 'More download platforms'}</span>
        </summary>
        <div class="store-menu__panel">
          {additionalStores.map((store) => (
            <a href={store.href} target="_blank" rel="noopener">
              <span aria-hidden="true">{store.icon}</span>
              {store.label}
            </a>
          ))}
        </div>
      </details>
    )}
    {helpHref && <a class="button button--ghost" href={helpHref}>{locale === 'zh' ? '帮助' : 'Help'}</a>}
  </div>
</article>
