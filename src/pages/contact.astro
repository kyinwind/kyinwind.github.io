---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Contact — MichaelDev"
  description="Contact MichaelDev for app feedback, support questions, and product suggestions."
>
  <main>
    <section class="contact-hero">
      <p class="eyebrow">Contact</p>
      <h1>Feedback and support</h1>
      <p class="hero__copy">
        If you have a question, bug report, or feature idea for a MichaelDev app, these are the best ways to reach me.
      </p>
    </section>

    <section class="contact-grid" aria-label="Contact methods">
      <article class="contact-card">
        <span class="contact-card__icon">✉</span>
        <div>
          <h2>Email</h2>
          <p>Best for support questions, screenshots, examples, and detailed feedback.</p>
          <a class="contact-card__link" href="mailto:yangxuehui@outlook.com">yangxuehui@outlook.com</a>
        </div>
      </article>

      <article class="contact-card">
        <span class="contact-card__icon">Q</span>
        <div>
          <h2>QQ</h2>
          <p>For quick feedback and direct communication in Chinese.</p>
          <p class="contact-card__value">361794868</p>
        </div>
      </article>

      <article class="contact-card">
        <span class="contact-card__icon">钉</span>
        <div>
          <h2>DingTalk</h2>
          <p>DingTalk feedback is supported inside the apps. A public web contact link can be added here later.</p>
          <p class="contact-card__value">Available in supported apps</p>
        </div>
      </article>

      <article class="contact-card">
        <span class="contact-card__icon">D</span>
        <div>
          <h2>Discord</h2>
          <p>Discord feedback is supported inside the apps. A public server invite can be added here later.</p>
          <p class="contact-card__value">Invite link to be added</p>
        </div>
      </article>
    </section>
  </main>
</SiteLayout>
